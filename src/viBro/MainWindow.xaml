<Window x:Class="ViBro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mpv="clr-namespace:ViBro.Mpv"
        Title="viBro" Width="1280" Height="820" MinWidth="640" MinHeight="420"
        PreviewKeyDown="Window_PreviewKeyDown"
        ContentRendered="Window_ContentRendered"
        Closing="Window_Closing">
    <DockPanel>
        <!-- Path bar and prototype test switches -->
        <DockPanel x:Name="TopBar" DockPanel.Dock="Top" Margin="4">
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..." Margin="4,0,0,0"
                    Padding="10,2" Focusable="False" Click="BrowseButton_Click" />
            <ComboBox x:Name="HwdecBox" DockPanel.Dock="Right" Width="95" Margin="4,0,0,0" Focusable="False"
                      ToolTip="Hardware decoding (applies immediately)"
                      SelectionChanged="HwdecBox_SelectionChanged">
                <ComboBoxItem Content="auto-safe" IsSelected="True" />
                <ComboBoxItem Content="no" />
            </ComboBox>
            <TextBlock DockPanel.Dock="Right" Text="HW decoding:" VerticalAlignment="Center" Margin="12,0,0,0" />
            <CheckBox x:Name="ExactSeekBox" DockPanel.Dock="Right" Content="Exact seeks" VerticalAlignment="Center"
                      Margin="12,0,0,0" Focusable="False"
                      ToolTip="Off: jump to keyframes (fast, approximate). On: exact position (slower)."
                      Checked="ExactSeekBox_Changed" Unchecked="ExactSeekBox_Changed" />
            <TextBox x:Name="PathBox" VerticalContentAlignment="Center" Padding="2"
                     ToolTip="Folder path (local, mapped drive or \\server\share). Enter to open, Esc to cancel."
                     PreviewKeyDown="PathBox_PreviewKeyDown" />
        </DockPanel>

        <StatusBar x:Name="StatusPanel" DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="MetricsText" />
            </StatusBarItem>
        </StatusBar>

        <!-- Transport -->
        <DockPanel x:Name="TransportBar" DockPanel.Dock="Bottom" Margin="4">
            <Button x:Name="PlayButton" DockPanel.Dock="Left" Width="70" Content="Play" Focusable="False"
                    Click="PlayButton_Click" />
            <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="110" Minimum="0" Maximum="100" Value="100"
                    Focusable="False" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                    ValueChanged="VolumeSlider_ValueChanged" />
            <Button x:Name="MuteButton" DockPanel.Dock="Right" Width="64" Content="Mute" Focusable="False"
                    Margin="8,0,6,0" Click="MuteButton_Click" />
            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                       FontFamily="Consolas" Text="00:00:00 / 00:00:00" />
            <Slider x:Name="TimeSlider" Minimum="0" Maximum="1" Focusable="False" IsMoveToPointEnabled="True"
                    VerticalAlignment="Center" Margin="10,0,0,0" ValueChanged="TimeSlider_ValueChanged" />
        </DockPanel>

        <!-- Video (top) and file list (bottom). The folder tree arrives in 0.2.0. -->
        <Grid x:Name="MainArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="60" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Black">
                <mpv:MpvHost x:Name="VideoHost" />
            </Border>

            <GridSplitter x:Name="ListSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Focusable="False" />

            <ListView x:Name="FileList" Grid.Row="2" SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="FileList_SelectionChanged">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="520" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Size" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Date modified" Width="150" DisplayMemberBinding="{Binding ModifiedText}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
