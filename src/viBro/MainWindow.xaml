<Window x:Class="ViBro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mpv="clr-namespace:ViBro.Mpv"
        xmlns:util="clr-namespace:ViBro.Util"
        Title="viBro" Icon="viBro.ico" Width="1280" Height="820" MinWidth="640" MinHeight="420"
        PreviewKeyDown="Window_PreviewKeyDown"
        ContentRendered="Window_ContentRendered"
        Closing="Window_Closing">
    <Window.Resources>
        <util:TreeIconConverter x:Key="TreeIconConverter" />
    </Window.Resources>
    <DockPanel>
        <!-- Path bar -->
        <DockPanel x:Name="TopBar" DockPanel.Dock="Top" Margin="4">
            <!-- Icon buttons (Segoe Fluent Icons, built into Windows 11; MDL2 Assets as fallback). -->
            <Button x:Name="ThemeButton" DockPanel.Dock="Right" Content="&#xE706;" Margin="4,0,0,0" Width="36"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Padding="0,4" Focusable="False" Click="ThemeButton_Click" />
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="&#xE838;" Margin="4,0,0,0" Width="36"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Padding="0,4" Focusable="False" Click="BrowseButton_Click"
                    ToolTip="Browse for a folder" />
            <!-- Decorative folder icon, the same as in the tree. -->
            <Image x:Name="PathIcon" DockPanel.Dock="Left" Width="16" Height="16" Margin="2,0,6,0"
                   VerticalAlignment="Center" Focusable="False" />
            <!-- 1.13.0: clickable "breadcrumbs"; a click on the empty part (or Ctrl+L) turns the bar into
                 an editable path, as in File Explorer. -->
            <Grid>
                <Border x:Name="CrumbBar" BorderThickness="1" CornerRadius="4" BorderBrush="#40808080" Background="Transparent"
                        MinHeight="30" Padding="2,0" Cursor="IBeam" PreviewMouseLeftButtonUp="CrumbBar_PreviewMouseLeftButtonUp"
                        ToolTip="Click a folder to open it; click the empty part (or Ctrl+L) to type a path. Backspace: parent folder.">
                    <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" VerticalAlignment="Center">
                        <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                </Border>
                <TextBox x:Name="PathBox" VerticalContentAlignment="Center" Padding="2" Visibility="Collapsed"
                         ToolTip="Folder path (local, mapped drive or \\server\share). Enter opens, Esc cancels."
                         PreviewKeyDown="PathBox_PreviewKeyDown" LostKeyboardFocus="PathBox_LostKeyboardFocus" />
            </Grid>
        </DockPanel>

        <!-- Compact status bar in three zones (1.13.0): left the folder summary, right the format of the
             loaded video (and the measurements, only with [Diagnostics] MetricsLog=true), centre the
             messages: errors orange and results green stay 6 s; a click shows the last 20 messages. -->
        <StatusBar x:Name="StatusPanel" DockPanel.Dock="Bottom" Padding="4,0">
            <StatusBarItem Padding="4,1">
                <TextBlock x:Name="WarningText" Foreground="DarkOrange" FontWeight="SemiBold" Visibility="Collapsed" />
            </StatusBarItem>
            <StatusBarItem Padding="4,1">
                <TextBlock x:Name="FolderSummaryText" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem x:Name="MetricsItem" DockPanel.Dock="Right" Padding="4,1" Visibility="Collapsed">
                <TextBlock x:Name="MetricsText" />
            </StatusBarItem>
            <Separator x:Name="MetricsSeparator" DockPanel.Dock="Right" Visibility="Collapsed" />
            <StatusBarItem DockPanel.Dock="Right" Padding="4,1">
                <TextBlock x:Name="MediaText" />
            </StatusBarItem>
            <Separator DockPanel.Dock="Right" />
            <StatusBarItem Padding="4,1" Cursor="Hand" MouseLeftButtonUp="StatusText_MouseLeftButtonUp"
                           ToolTip="Click: the last 20 messages">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis" />
                    <Popup x:Name="StatusHistoryPopup" PlacementTarget="{Binding ElementName=StatusText}" Placement="Top"
                           StaysOpen="False" AllowsTransparency="True">
                        <Border x:Name="StatusHistoryBorder" BorderThickness="1" BorderBrush="#60808080" CornerRadius="4" Padding="8,6">
                            <StackPanel x:Name="StatusHistoryList" MinWidth="320" MaxWidth="900" />
                        </Border>
                    </Popup>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <!-- Left: folder tree (full height). Right: video (top) and file list (bottom). -->
        <Grid x:Name="MainArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="280" MinWidth="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="FolderTree" Grid.Column="0"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectedItemChanged="FolderTree_SelectedItemChanged"
                      TreeViewItem.Selected="FolderTree_ItemSelected">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Image Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Image.Source>
                                    <MultiBinding Converter="{StaticResource TreeIconConverter}">
                                        <Binding Path="Kind" />
                                        <Binding Path="Name" />
                                        <Binding Path="IsExpanded" />
                                    </MultiBinding>
                                </Image.Source>
                            </Image>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="5" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Focusable="False" />

            <Grid x:Name="RightArea" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="ListRow" Height="260" MinHeight="60" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <!-- Transport, below the video and above the file list (same cell as the video, so the
                         splitter resizes video + transport against the list). In fullscreen it becomes a black
                         band with only the timeline, centred and ~40% wide, shown on mouse movement or seeks. -->
                    <Border x:Name="TransportBar" DockPanel.Dock="Bottom" Padding="4" MouseMove="TransportBar_MouseMove">
                        <DockPanel>
                            <Button x:Name="PlayButton" DockPanel.Dock="Left" Width="40" Content="&#xE768;" Focusable="False"
                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Padding="0,4" Click="PlayButton_Click"
                                    ToolTip="Play (Space, or click on the video)" />
                            <StackPanel x:Name="AudioControls" DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="MuteButton" Width="40" Content="&#xE767;" Focusable="False"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Padding="0,4" Margin="8,0,6,0" Click="MuteButton_Click"
                                        ToolTip="Mute (M)" />
                                <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="100" Value="100"
                                        Focusable="False" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                        ValueChanged="VolumeSlider_ValueChanged" />
                            </StackPanel>
                            <DockPanel x:Name="SeekPanel">
                                <!-- Time under the pointer (no picture preview: nothing is read from the file). -->
                                <Popup x:Name="TimeHoverPopup" PlacementTarget="{Binding ElementName=TimeSlider}" Placement="Top"
                                       IsHitTestVisible="False" Focusable="False" StaysOpen="True">
                                    <Border x:Name="TimeHoverBorder" BorderThickness="1" Padding="6,2" CornerRadius="4">
                                        <TextBlock x:Name="TimeHoverText" FontFamily="Consolas" />
                                    </Border>
                                </Popup>
                                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0"
                                           FontFamily="Consolas" Text="0:00 / 0:00" />
                                <Grid Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Slider x:Name="TimeSlider" Minimum="0" Maximum="1" Focusable="False" IsMoveToPointEnabled="True"
                                            ValueChanged="TimeSlider_ValueChanged" SizeChanged="TimeSlider_SizeChanged"
                                            MouseMove="TimeSlider_MouseMove" MouseLeave="TimeSlider_MouseLeave" />
                                    <!-- Extract markers I / O and the part between them (1.5.0); never takes the mouse. -->
                                    <Canvas x:Name="MarkerCanvas" IsHitTestVisible="False" ClipToBounds="False">
                                        <Rectangle x:Name="MarkRange" Height="4" Fill="#FFD000" Opacity="0.55" Visibility="Collapsed" />
                                        <Rectangle x:Name="MarkInLine" Width="3" Fill="#2EBD59" Visibility="Collapsed" ToolTip="I" />
                                        <Rectangle x:Name="MarkOutLine" Width="3" Fill="#E5484D" Visibility="Collapsed" ToolTip="O" />
                                    </Canvas>
                                </Grid>
                            </DockPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="Black">
                        <Grid>
                            <!-- 1.13.0: shown while no video is loaded (the native video window is hidden then,
                                 because nothing can be drawn over it). -->
                            <TextBlock x:Name="VideoPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#909090" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="20" />
                            <mpv:MpvHost x:Name="VideoHost" />
                        </Grid>
                    </Border>
                </DockPanel>

                <GridSplitter x:Name="ListSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Focusable="False" />

                <ListView x:Name="FileList" Grid.Row="2" SelectionMode="Extended"
                          PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="FileList_PreviewMouseLeftButtonUp"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="FileList_SelectionChanged"
                          MouseDoubleClick="FileList_MouseDoubleClick"
                          GridViewColumnHeader.Click="FileList_HeaderClick">
                    <ListView.View>
                        <GridView>
                            <!-- The loaded file: play/pause glyph and semibold name, independent of the selection. -->
                            <GridViewColumn x:Name="NameColumn" Header="Name" Width="480">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Grid Width="18">
                                                <!-- Folder icon for folders and "..", play/pause glyph for the loaded video. -->
                                                <Image Source="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StateGlyph}" FontSize="11" VerticalAlignment="Center"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                            </Grid>
                                            <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="SizeColumn" Header="Size" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}" TextAlignment="Right" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn x:Name="DateColumn" Header="Date modified" Width="150"
                                            DisplayMemberBinding="{Binding ModifiedText}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
